# Afterlight Environment Variables Example
# Copy to .env.local or .env for local overrides

# Transport mode: phoenix (recommended) or node
VITE_TRANSPORT=phoenix

# WebSocket URL for real-time gateway (defaults to ws://localhost:4000/ws in development)
# For production, set to your public WebSocket endpoint, e.g. wss://backend.example.com/ws
VITE_WS_URL=ws://localhost:4000/ws

# Realtime acceleration flags
VITE_RT_BINARY=1
VITE_RT_WASM=1
VITE_RT_WORKER=1

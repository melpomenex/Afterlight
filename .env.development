# Phoenix gateway dev stack (add-phoenix-gateway-transport).
# Node shadow server must still run on :3001 for theater/garden/theater HTTP.
VITE_TRANSPORT=phoenix
VITE_WS_URL=ws://localhost:4000/ws

# Realtime acceleration (binary data plane + WASM worker + WebGPU proxies).
VITE_RT_BINARY=1
VITE_RT_WASM=1
VITE_RT_WORKER=1
VITE_RT_WEBGPU_FASTPATH=1

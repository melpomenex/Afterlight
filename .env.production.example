VITE_TRANSPORT=phoenix
# Public WebSocket endpoint for the production gateway.
# Example: wss://backend.example.com/ws
VITE_WS_URL=wss://example.invalid/ws

# Realtime acceleration (benchmarked binary data plane + WASM worker).
# WebGPU instanced proxies stay opt-in per load (?rt_webgpu_fastpath=1 or the
# personal afterlight-rt-flags storage key); never enable them for live play by
# default (docs/architecture/realtime/gpu-rendering.md).
VITE_RT_BINARY=1
VITE_RT_WASM=1
VITE_RT_WORKER=1

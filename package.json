{
  "name": "afterlight-courtyard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:phoenix": "vite --host 0.0.0.0 --mode development",
    "server": "node server/index.js",
    "server:elixir": "cd server_elixir && PHX_SERVER=true mix phx.server",
    "dev:stack": "bash scripts/dev-elixir-stack.sh",
    "verify:gateway": "node scripts/verify-gateway-transport.mjs",
    "verify:world": "node scripts/verify-world-runtime.mjs",
    "verify:chat": "node scripts/verify-social-chat.mjs",
    "verify:p11": "node scripts/verify-p11-e2e-sweep.mjs",
    "verify:theater": "node scripts/verify-theater-cutover.mjs",
    "verify:media": "node scripts/theater-media-smoke.mjs",
    "p11:snapshot-hashes": "node scripts/p11-snapshot-hashes.mjs",
    "p11:audit": "node scripts/audit-node-write-paths.mjs",
    "load:smoke": "node tools/load_client/cli.js smoke",
    "load:run": "node tools/load_client/cli.js run",
    "build:wasm": "cargo build --manifest-path wasm/afterlight-realtime/Cargo.toml --target wasm32-unknown-unknown --release && mkdir -p public/wasm && cp wasm/afterlight-realtime/target/wasm32-unknown-unknown/release/afterlight_realtime.wasm public/wasm/afterlight_realtime.wasm",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "bash deploy/deploy.sh",
    "deploy:backend": "bash deploy/remote-deploy.sh",
    "deploy:frontend": "bash deploy/vercel-deploy.sh",
    "test": "node --test tests/*.test.js tests/**/*.test.js"
  },
  "dependencies": {
    "hls.js": "^1.7.2",
    "phoenix": "^1.8.13",
    "three": "^0.180.0",
    "vercel": "^59.12.0",
    "vite": "^7.1.0",
    "webtorrent": "^3.0.21",
    "ws": "^8.18.0"
  }
}

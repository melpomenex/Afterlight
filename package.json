{
  "name": "afterlight-courtyard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:phoenix": "vite --host 0.0.0.0 --mode development",
    "server": "node server/index.js",
    "server:elixir": "cd server_elixir && PHX_SERVER=true mix phx.server",
    "dev:stack": "bash scripts/dev-elixir-stack.sh",
    "verify:gateway": "node scripts/verify-gateway-transport.mjs",
    "verify:world": "node scripts/verify-world-runtime.mjs",
    "verify:chat": "node scripts/verify-social-chat.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "hls.js": "^1.7.2",
    "phoenix": "^1.8.13",
    "three": "^0.180.0",
    "vite": "^7.1.0",
    "webtorrent": "^3.0.21",
    "ws": "^8.18.0"
  }
}

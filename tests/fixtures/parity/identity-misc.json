      "id": "yt/classic-renderers",
      "fn": "extractPlaylistVideos",
      "args": [
        "<html><script>var ytInitialData = {\"title\":\"Parity List\",\"contents\":[{\"playlistVideoRenderer\":{\"videoId\":\"vid00000001\",\"title\":{\"runs\":[{\"text\":\"One\"}]}}},{\"playlistVideoRenderer\":{\"videoId\":\"vid00000002\",\"title\":{\"runs\":[{\"text\":\"Two\"}]}}},{\"playlistVideoRenderer\":{\"videoId\":\"vid00000001\",\"title\":{\"runs\":[{\"text\":\"One Again\"}]}}}]};</script></html>"
      ],
      "expected": {
        "title": "A YouTube playlist",
        "videos": [
          {
            "videoId": "vid00000001",
            "title": "One"
          },
          {
            "videoId": "vid00000002",
            "title": "Two"
          }
        ]
      }
    },
